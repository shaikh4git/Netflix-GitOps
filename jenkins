
pipeline {
    agent { label 'DevopsAgentLabelV5' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_REPO = 'shaikhdocker/netflix'
        GITOPS_REPO = 'https://github.com/shaikh4git/Netflix-GitOps.git'
        GITOPS_BRANCH = 'main'
    }

    tools {
        jdk 'SystemJDK'
        nodejs 'node20'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/shaikh4git/DevSecOps-Project.git'

                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    env.FULL_IMAGE = "${env.IMAGE_REPO}:${env.IMAGE_TAG}"
                }

                echo "Building ${env.FULL_IMAGE}"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        /opt/sonar-scanner/bin/sonar-scanner \
                          -Dsonar.projectName=Netflix \
                          -Dsonar.projectKey=Netflix
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate(
                        abortPipeline: true,
                        credentialsId: 'Sonar-token'
                    )
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    /home/jenkins/bin/trivy fs . \
                      > trivyfs.txt
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'docker_cred',
                        variable: 'DOCKER_API_KEY'
                    ),
                    string(
                        credentialsId: 'tmdb_api_key',
                        variable: 'TMDB_KEY'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_API_KEY" |
                          docker login -u shaikhdocker --password-stdin

                        docker buildx build \
                          --build-arg TMDB_V3_API_KEY="$TMDB_KEY" \
                          --tag "$FULL_IMAGE" \
                          --load \
                          .

                        docker push "$FULL_IMAGE"
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    /home/jenkins/bin/trivy image \
                      "$FULL_IMAGE" > trivyimage.txt
                '''
            }
        }

        stage('Deploy to Docker - Staging') {
            steps {
                sh '''
                    docker pull "$FULL_IMAGE"

                    if docker ps -aq \
                      --filter "name=^netflix$" | grep -q .; then
                        docker rm -f netflix
                    fi

                    docker run -d \
                      --name netflix \
                      -p 8081:80 \
                      "$FULL_IMAGE"
                '''
            }
        }

        stage('Approval for Production') {
            steps {
                input message: "Deploy ${env.FULL_IMAGE} to Kubernetes?",
                      ok: 'Approve Production Deployment'
            }
        }

        stage('Update GitOps Repository') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-gitops-token',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        AUTH_DIR="$(mktemp -d)"
                        trap 'rm -rf "$AUTH_DIR"' EXIT

                        cat > "$AUTH_DIR/askpass.sh" <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GIT_USERNAME" ;;
  *Password*) printf '%s\\n' "$GIT_TOKEN" ;;
  *) exit 1 ;;
esac
EOF
                        chmod 700 "$AUTH_DIR/askpass.sh"
                        export GIT_ASKPASS="$AUTH_DIR/askpass.sh"
                        export GIT_TERMINAL_PROMPT=0

                        git clone \
                          --branch "$GITOPS_BRANCH" \
                          "$GITOPS_REPO" gitops

                        cd gitops

                        test -f netflix/deployment.yml

                        python3 - <<'PY'
import os
import re
from pathlib import Path

path = Path("netflix/deployment.yml")
text = path.read_text()

image = os.environ["FULL_IMAGE"]

pattern = r'(?m)^(\\s*image:\\s*)shaikhdocker/netflix:[^\\s]+'

text, count = re.subn(
    pattern,
    lambda match: match.group(1) + image,
    text
)

if count != 1:
    raise SystemExit(
        f"Expected exactly one Netflix image, found {count}"
    )

path.write_text(text)
PY

                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@localhost"

                        git add netflix/deployment.yml
                        git commit -m "Deploy Netflix $FULL_IMAGE"

                        git push origin "HEAD:$GITOPS_BRANCH"
                    '''
                }
            }
        }

        stage('GitOps Commit Published') {
            steps {
                echo """
                Jenkins pushed the approved image tag to Git.

                Image: ${env.FULL_IMAGE}
                Repository: ${env.GITOPS_REPO}

                Argo CD will reconcile the Netflix application.
                """
            }
        }
    }

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.currentResult}",
                body: """
                    Project: ${env.JOB_NAME}<br/>
                    Build: ${env.BUILD_NUMBER}<br/>
                    Image: ${env.FULL_IMAGE ?: 'Not built'}<br/>
                    URL: ${env.BUILD_URL}<br/>
                """,
                to: 'shaikh4huda@gmail.com',
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }
    }
}
